---
interface Props {
  href: string;
  ariaLabel?: string;
  class?: string;
}

const { href, ariaLabel, class: className } = Astro.props;
---

<a
  href={href}
  class={`text-phosphor underline decoration-phosphor/40 underline-offset-4 transition-colors hover:text-ink hover:decoration-phosphor ${className ?? ""}`}
  aria-label={ariaLabel}
>
  <slot />
</a>
