---
import { getCollection } from "astro:content";
import Tag from "@/components/Tag.astro";

const posts = await getCollection("blog");
const published = posts.filter((post) => !post.data.draft);

const counts = new Map<string, number>();
for (const post of published) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 6)
  .map(([name, count]) => ({ name, count }));
---

<div class="sticky top-6 space-y-8">
  <section>
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
      about
    </p>
    <p class="font-serif text-base leading-relaxed text-ink-dim">
      Cross-platform developer at a local startup. I write about building things
      that work&mdash;and fixing things that don&rsquo;t.
    </p>
  </section>

  <section>
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
      tags
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        topTags.map((tag) => (
          <li>
            <Tag name={tag.name} count={tag.count} variant="small" />
          </li>
        ))
      }
    </ul>
  </section>
</div>
