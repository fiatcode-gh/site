---
import { getQuote } from "@/lib/quote";
const { quote, author } = getQuote();
---

<div class="sticky top-6">
  <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
    <span class="text-phosphor">$</span> fortune
  </p>
  <blockquote class="border-l-2 border-phosphor/40 pl-4">
    <p class="font-serif text-base italic leading-relaxed text-ink-dim">
      {quote}
    </p>
    <footer class="mt-3 font-mono text-xs text-ink-faint">
      <span class="text-phosphor/70">&mdash;</span>
      {author}
    </footer>
  </blockquote>
</div>
