---
const links = [
  { href: "/posts", label: "posts" },
  { href: "/tools", label: "tools" },
  { href: "/tags", label: "tags" },
  { href: "/search", label: "search" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="reveal flex flex-wrap items-center gap-x-5 gap-y-3 py-7"
  style="--d: 0"
>
  <a
    href="/"
    aria-label="Home"
    class="font-mono text-sm font-semibold tracking-tight text-ink transition-colors hover:text-phosphor"
  >
    fiatcode<span class="text-phosphor">.</span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {
        links.map((link) => (
          <li class="flex items-center">
            <a
              href={link.href}
              class:list={[
                "relative py-1 transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-phosphor after:transition-transform after:duration-200 hover:text-phosphor hover:after:scale-x-100",
                isActive(link.href)
                  ? "text-phosphor after:scale-x-100"
                  : "text-ink-dim",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
