---
import { sectionOf, sections } from "@/lib/nav";

/**
 * Title bar: the logo, then one editor tab per section. The section the
 * page lives in is the open tab — surface background, a top bar in
 * --active, and aria-current, so it never relies on hue alone.
 *
 * At >= 1240px the logo cell is exactly as wide as the Explorer below it,
 * so the two share one vertical rule. Below 620px the logo takes its own
 * row and the four tabs split the next one evenly.
 */
const path = Astro.url.pathname;
const current = sectionOf(path);
---

<header class="titlebar">
  <a
    href="/"
    class="logo"
    aria-label="fiatcode.dev, home"
    aria-current={path === "/" ? "page" : undefined}
  >
    <span class="logo-mark" aria-hidden="true">f</span>
    <span aria-hidden="true">fiatcode<span class="tld">.dev</span></span>
  </a>
  <nav aria-label="Main">
    <ul class="tabs">
      {
        sections.map((s) => (
          <li>
            <a
              href={`/${s}/`}
              aria-current={current === s ? "page" : undefined}
            >
              {s === "search" && (
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <circle cx="7" cy="7" r="4.5" />
                  <path d="m10.5 10.5 3.5 3.5" />
                </svg>
              )}
              {s}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .titlebar {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-chrome);
    font-family: var(--font-mono);
  }

  .logo {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    box-sizing: border-box;
    width: 260px;
    padding: 0 20px;
    border-right: 1px solid var(--color-line);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-fn);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-surface);
  }

  .tld {
    font-weight: 400;
    color: var(--color-faint);
  }

  .tabs {
    display: flex;
  }

  .tabs a {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-right: 1px solid var(--color-line);
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .tabs a:hover {
    background: var(--color-hover);
    color: var(--color-fg);
  }

  /* The open tab sits on the buffer: it drops over the title bar's bottom
     rule so the two surfaces join. */
  .tabs a[aria-current="page"] {
    margin-bottom: -1px;
    background: var(--color-surface);
    color: var(--color-fg);
    font-weight: 600;
    box-shadow: inset 0 2px 0 var(--color-active);
  }

  .logo:focus-visible,
  .tabs a:focus-visible {
    outline-offset: -2px;
  }

  .tabs svg {
    flex: none;
    width: 14px;
    height: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tabs a {
      transition:
        background-color 120ms ease,
        color 120ms ease;
    }
  }

  @media (width < 1240px) {
    .logo {
      width: auto;
    }
  }

  @media (width < 620px) {
    .titlebar {
      flex-wrap: wrap;
    }

    .logo {
      width: 100%;
      min-height: 52px;
      padding: 0 18px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .titlebar > nav {
      flex: 1 1 100%;
    }

    .tabs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .tabs a {
      justify-content: center;
      height: 48px;
      padding: 0;
    }

    .tabs li:last-child a {
      border-right: 0;
    }
  }
</style>
