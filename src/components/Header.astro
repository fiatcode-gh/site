---
const links = [
  { href: "/posts", label: "posts" },
  { href: "/tags", label: "tags" },
  { href: "/search", label: "search" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="reveal flex flex-wrap items-center gap-x-5 gap-y-3 py-7"
  style="--d: 0"
>
  <a
    href="/"
    aria-label="Home"
    class="group inline-flex items-center gap-1.5 text-sm font-medium text-ink-dim transition-colors hover:text-ink"
  >
    <span class="text-phosphor">~</span>
    <span
      class="bg-phosphor px-1.5 py-0.5 text-bg transition-colors group-hover:bg-phosphor-deep"
      >fiatcode</span
    >
  </a>

  <nav aria-label="Main navigation">
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {
        links.map((link) => (
          <li class="flex items-center">
            <span class="text-ink-faint" aria-hidden="true">
              ./
            </span>
            <a
              href={link.href}
              class:list={[
                "transition-colors underline-offset-4 hover:text-phosphor hover:underline",
                isActive(link.href)
                  ? "text-phosphor underline"
                  : "text-ink-dim",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
