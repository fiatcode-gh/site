---
/**
 * Section header for /posts, /tools, /tags, a tag page and /search: an
 * optional code-comment line, the h1 with optional meta on its right, then
 * an optional lead paragraph.
 */
interface Props {
  title: string;
  /** Mono meta line above the title, written as a `//` comment. */
  comment?: string;
  /** Lead paragraph below the title. May carry inline HTML. */
  lead?: string;
}

const { title, comment, lead } = Astro.props;
---

<header class="page-head">
  {comment && <p class="comment">// {comment}</p>}
  <div class="page-head-row">
    <h1 class="page-title">{title}</h1>
    {
      Astro.slots.has("aside") && (
        <div class="page-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  {lead && <p class="page-lead" set:html={lead} />}
  <slot />
</header>
