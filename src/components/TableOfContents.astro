---
import { filterHeadings } from "@/lib/toc";
import type { MarkdownHeading } from "astro";

/**
 * A post's contents list, in two forms — the post page renders both and CSS
 * picks one, because they cannot be the same DOM node: the rail lives in the
 * Outline column beside the article, the mobile list above the prose.
 *
 * `rail` (>= 900px) — inside the sticky Outline aside. Scroll-spied: the
 * reader's current section gets aria-current, a bar in --active and fg
 * weight, so it never relies on hue alone.
 *
 * `mobile` (< 900px) — a native <details> in normal flow, collapsed, with
 * 48px rows. No JavaScript, no fixed positioning, no overlay.
 *
 * Sections (h3) carry the same 01, 02… numbers as the headings in the prose
 * (a CSS counter there); h4 sub-sections are indented and unnumbered.
 */
interface Props {
  headings: MarkdownHeading[];
  variant?: "rail" | "mobile";
}

const { headings, variant = "rail" } = Astro.props;

let section = 0;
const items = filterHeadings(headings).map((h) => ({
  ...h,
  number: h.depth === 3 ? String(++section).padStart(2, "0") : null,
}));
const sectionLabel = `${section} ${section === 1 ? "section" : "sections"}`;
---

{
  items.length >= 2 &&
    (variant === "rail" ? (
      <nav class="toc" aria-label="Contents">
        <ol>
          {items.map((item) => (
            <li>
              <a
                href={`#${item.slug}`}
                data-toc-link={item.slug}
                class:list={[item.number === null && "sub"]}
              >
                <span class="num" aria-hidden="true">
                  {item.number}
                </span>
                <span>{item.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <details class="toc-mobile">
        <summary>
          Contents <span class="count">{sectionLabel}</span>
        </summary>
        <nav aria-label="Contents">
          <ol>
            {items.map((item) => (
              <li>
                <a
                  href={`#${item.slug}`}
                  class:list={[item.number === null && "sub"]}
                >
                  <span class="num" aria-hidden="true">
                    {item.number}
                  </span>
                  <span>{item.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ))
}

<style>
  .num {
    font: 500 0.75rem/1.75 var(--font-mono);
    color: var(--color-kw);
  }

  /* ── Rail, >= 900px ──────────────────────────────────────── */

  .toc a {
    display: grid;
    grid-template-columns: 2em minmax(0, 1fr);
    gap: 4px;
    margin-left: -1px;
    padding: 6px 12px 6px 20px;
    border-left: 2px solid transparent;
    font: 400 0.875rem/1.45 var(--font-sans);
    color: var(--color-muted);
    text-decoration: none;
  }

  .toc a.sub {
    padding-left: 34px;
    font-size: 0.8125rem;
  }

  .toc a:hover {
    border-left-color: var(--color-line-strong);
    background: var(--color-hover);
    color: var(--color-fg);
  }

  /* The reader's current section, set by the script below. */
  .toc a[aria-current] {
    border-left-color: var(--color-active);
    font-weight: 600;
    color: var(--color-fg);
  }

  .toc a:focus-visible {
    outline-offset: -2px;
  }

  /* ── Mobile, < 900px ─────────────────────────────────────── */

  .toc-mobile {
    display: none;
    margin: 0 0 28px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-raised);
    font-family: var(--font-mono);
  }

  .toc-mobile summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 16px;
    font-size: 0.8125rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile summary::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--color-faint);
    border-bottom: 1.5px solid var(--color-faint);
    transform: rotate(-45deg);
  }

  .toc-mobile[open] summary::before {
    transform: rotate(45deg);
  }

  .toc-mobile .count {
    margin-left: auto;
    font-weight: 400;
    color: var(--color-faint);
  }

  .toc-mobile ol {
    padding: 4px 0 10px;
    border-top: 1px solid var(--color-line);
  }

  .toc-mobile a {
    display: grid;
    grid-template-columns: 2em minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 6px 16px;
    font: 400 0.9375rem/1.4 var(--font-sans);
    color: var(--color-fg);
    text-decoration: none;
  }

  .toc-mobile a.sub {
    padding-left: 32px;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc a {
      transition:
        background-color 120ms ease,
        color 120ms ease,
        border-color 120ms ease;
    }

    .toc-mobile summary::before {
      transition: transform 150ms ease;
    }
  }

  @media (width < 900px) {
    .toc-mobile {
      display: block;
    }
  }
</style>

<script>
  import { activeHeadingId } from "../lib/toc";

  // Only the rail is scroll-spied. The mobile copies carry no data-toc-link,
  // so a collapsed list cannot pull the highlight off the visible rail.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  );

  if (links.length > 0) {
    const slugs = new Set(links.map((l) => l.dataset.tocLink));
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>("article h3[id], article h4[id]"),
    ).filter((el) => slugs.has(el.id));

    const setActive = (id: string | null) => {
      for (const link of links) {
        if (id !== null && link.dataset.tocLink === id) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    // The current section is the last heading whose top has scrolled past an
    // activation line near the top of the viewport. It stays current while
    // reading the body text below it.
    const update = () => {
      const offset = window.innerHeight * 0.3;
      const entries = targets.map((el) => ({
        id: el.id,
        top: el.getBoundingClientRect().top,
      }));
      setActive(activeHeadingId(entries, offset));
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  }
</script>
