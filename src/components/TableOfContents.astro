---
// src/components/TableOfContents.astro
import type { MarkdownHeading } from "astro";
import { filterHeadings } from "@/lib/toc";
import TocList from "@/components/TocList.astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "sidebar" | "mobile";
  postId?: string;
}

const { headings, variant = "sidebar", postId } = Astro.props;
const items = filterHeadings(headings);
const show = items.length >= 2;
const label = `grep '^#' ${postId ?? "post"}.md`;
---

{
  show &&
    (variant === "sidebar" ? (
      <nav
        aria-label="Table of contents"
        class="sticky top-6 hidden md:block"
      >
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
          <span class="text-phosphor">$</span> {label}
        </p>
        <ul class="space-y-1.5 border-l-2 border-line-soft pl-4">
          <TocList items={items} />
        </ul>
      </nav>
    ) : (
      <details class="mb-8 border border-line-soft bg-surface-2/40 md:hidden">
        <summary class="cursor-pointer px-4 py-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
          <span class="text-phosphor">$</span> {label}
        </summary>
        <ul class="space-y-1.5 border-t border-line-soft px-4 py-3">
          <TocList items={items} />
        </ul>
      </details>
    ))
}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  );
  if (links.length > 0) {
    const slugs = new Set(links.map((l) => l.dataset.tocLink));
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>("article h2[id], article h3[id]"),
    ).filter((el) => slugs.has(el.id));

    const setActive = (id: string | null) => {
      for (const link of links) {
        const isActive = id !== null && link.dataset.tocLink === id;
        link.classList.toggle("text-phosphor", isActive);
        link.classList.toggle("text-ink-faint", !isActive);
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        setActive(visible.length > 0 ? visible[0].target.id : null);
      },
      { rootMargin: "0px 0px -70% 0px", threshold: 0 },
    );

    for (const t of targets) observer.observe(t);
  }
</script>
