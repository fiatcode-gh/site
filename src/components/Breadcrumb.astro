---
import type { Crumb } from "@/lib/nav";

/**
 * File-path breadcrumb under the title bar:
 * `fiatcode.dev › posts › 2026 › <slug>.md`.
 *
 * Always one line. Ancestors keep their full width; the last crumb (the
 * current page) shrinks and ends in an ellipsis instead of wrapping onto
 * a second row at narrow widths. Its full text stays in the DOM and in
 * `title`, and the page's h1 repeats it in words. Below 620px the root
 * crumb is dropped: the logo row directly above already says it.
 */
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const trail: Crumb[] = [{ label: "fiatcode.dev", href: "/" }, ...crumbs];
const last = trail.length - 1;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) =>
        i === last ? (
          <li class="current" aria-current="page" title={c.label}>
            {c.label}
          </li>
        ) : c.href ? (
          <li class:list={[i === 0 && "root"]}>
            <a href={c.href}>{c.label}</a>
          </li>
        ) : (
          <li>{c.label}</li>
        ),
      )
    }
  </ol>
</nav>

<style>
  .crumbs {
    padding: 9px 24px;
    border-bottom: 1px solid var(--color-line);
    font: 400 0.75rem/1.4 var(--font-mono);
    color: var(--color-muted);
  }

  .crumbs ol {
    display: flex;
    align-items: center;
    min-width: 0;
    white-space: nowrap;
  }

  .crumbs li {
    flex: none;
  }

  .crumbs li + li::before {
    content: "›";
    content: "›" / "";
    padding: 0 8px;
    color: var(--color-gutter);
  }

  .crumbs .current {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-fg);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-fn);
    text-decoration: underline;
  }

  @media (width < 620px) {
    .crumbs .root {
      display: none;
    }

    .crumbs .root + li::before {
      content: none;
    }

    .crumbs {
      padding: 0 18px;
    }

    .crumbs li {
      display: flex;
      align-items: center;
      min-height: 40px;
    }

    .crumbs .current {
      display: block;
      line-height: 40px;
    }

    .crumbs a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
  }
</style>
