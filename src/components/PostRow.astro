---
import TagList from "@/components/TagList.astro";
import { isoDate } from "@/lib/posts";
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";

/**
 * One post as a list item: ISO date left, then the title (the link), the
 * description and the tags. Shared by the home page, /posts, /search and
 * the tag pages, so every caller wraps rows in `<ol class="postlist">`.
 *
 * Below 620px the date column folds above the title (see .postlist in
 * global.css). Extra attributes land on the <li>; /search uses that to tag
 * each row for its filter.
 */
interface Props extends HTMLAttributes<"li"> {
  post: CollectionEntry<"blog">;
  /** h2 under a page h1, h3 under a section h2 (the home page). */
  level?: 2 | 3;
}

const { post, level = 2, ...attrs } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---

<li {...attrs}>
  <time datetime={post.data.date.toISOString()}>
    {isoDate(post.data.date)}
  </time>
  <div>
    <Heading class="post-title">
      <a href={`/posts/${post.id}/`}>{post.data.title}</a>
    </Heading>
    <p>{post.data.description}</p>
    <TagList tags={post.data.tags ?? []} />
  </div>
</li>
