---
interface Props {
  id: string;
  date: Date;
  title: string;
  description: string;
}

const { id, date, title, description } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});
const iso = date.toISOString().slice(0, 10);
---

<a
  href={`/posts/${id}`}
  class="group relative block border-l border-line-soft py-4 pl-5 transition-colors hover:border-phosphor"
>
  <span
    class="absolute -left-px top-4 hidden h-5 w-px bg-phosphor transition-all group-hover:block"
    aria-hidden="true"></span>

  <div class="flex items-center gap-3 font-mono text-xs text-ink-faint">
    <time datetime={iso} class="tabular-nums">{formatted}</time>
    <span class="h-px flex-1 bg-line-soft"></span>
  </div>

  <h2
    class="mt-2 font-serif text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-phosphor"
  >
    {title}
  </h2>
  <p class="mt-1 font-serif text-base leading-relaxed text-ink-dim">
    {description}
  </p>
</a>
