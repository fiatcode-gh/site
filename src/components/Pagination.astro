---
interface Props {
  currentPage: number;
  lastPage: number;
  getPageUrl: (page: number) => string;
}

const { currentPage, lastPage, getPageUrl } = Astro.props;

const linkClass =
  "inline-flex items-center gap-2 border border-line-soft px-3 py-1.5 font-mono text-sm text-ink-dim transition-colors hover:border-phosphor hover:text-phosphor";
---

<nav
  aria-label="Pagination Navigation"
  class="mt-10 flex items-center border-t border-line-soft pt-6"
>
  {
    currentPage > 1 && (
      <a href={getPageUrl(currentPage - 1)} class={linkClass}>
        <span aria-hidden="true">←</span> prev
      </a>
    )
  }
  <span class="mx-auto font-mono text-xs text-ink-faint tabular-nums">
    {currentPage} / {lastPage}
  </span>
  {
    currentPage < lastPage && (
      <a href={getPageUrl(currentPage + 1)} class={linkClass}>
        next <span aria-hidden="true">→</span>
      </a>
    )
  }
</nav>
