---
import TableOfContents from "@/components/TableOfContents.astro";
import Layout from "@/layouts/Layout.astro";
import { filterHeadings } from "@/lib/toc";
import {
  getCollection,
  render,
  type CollectionEntry,
  type RenderResult,
} from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return Promise.all(
    posts.map(async (post, i) => ({
      params: { id: post.id },
      props: {
        post,
        content: await render(post),
        // Sorted newest-first, so the *newer* neighbour is the previous index.
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
      },
    })),
  );
}

interface Props {
  post: CollectionEntry<"blog">;
  content: RenderResult;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
}

const { post, content, newer, older } = Astro.props;

const longDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// ~200 words per minute, rounded up, floor of 1.
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.round(words / 200));

const hasToc = filterHeadings(content.headings).length >= 2;
const sourceUrl = `https://git.fiatcode.dev/fiatcode/site/src/branch/main/src/content/blog/${post.id}.md`;
---

<Layout
  title={`${post.data.title} | fiatcode`}
  description={post.data.description}
>
  <!-- File-path breadcrumb -->
  <div class="band flex justify-between px-[26px] py-[11px] text-[11px]">
    <a href="/posts" class="hover:underline">&larr; all posts</a>
    <span class="text-ink-55">posts/{post.id}.md</span>
  </div>

  <!-- Title block -->
  <div class="band px-[26px] pb-7 pt-13">
    <div class="label-meta mb-[22px] flex flex-wrap gap-3.5">
      <time datetime={post.data.date.toISOString()}>{longDate}</time>
      <span class="text-ink-40" aria-hidden="true">&middot;</span>
      <span>{readTime} min read</span>
    </div>
    <h1 class="post-title display mb-5 max-w-[24ch] leading-[1.02]">
      {post.data.title}
    </h1>
    <p class="max-w-[72ch] text-[15px] leading-[1.65] text-ink-62">
      {post.data.description}
    </p>
    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="chip hover-accent">
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <!--
    Article and contents rail. The rail draws the shared vertical rule
    (border-left), so the article must not draw a border-right.
  -->
  <div class:list={["grid", hasToc && "post-grid"]}>
    <div class="px-[26px] pb-11 pt-9">
      <article class="prose-brut">
        <content.Content />
      </article>

      <div class="mt-8 flex flex-wrap gap-2.5 border-t border-ink pt-5">
        <a href="#top" class="chip hover-accent px-4 py-2.5 text-xs">
          &uarr; back to top
        </a>
        <a href="/posts" class="chip hover-accent px-4 py-2.5 text-xs">
          all posts
        </a>
        <a
          href={sourceUrl}
          class="chip hover-accent px-4 py-2.5 text-xs"
          rel="noopener"
        >
          source on Forgejo
        </a>
      </div>
    </div>

    {hasToc && <TableOfContents headings={content.headings} />}
  </div>

  <!--
    Previous / next. The pair sits in a hairline grid so the divider
    between the two cells is the 1px gap, not a border on either one.
  -->
  {
    (newer || older) && (
      <nav
        class="ruled band border-t border-ink min-[620px]:grid-cols-2"
        aria-label="Adjacent posts"
      >
        {older && (
          <a
            href={`/posts/${older.id}/`}
            rel="prev"
            class="cell hover-tint px-[26px] py-5"
          >
            <span class="label mb-2 block text-ink-55">&larr; Previous</span>
            <span class="text-[15px] font-semibold">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a
            href={`/posts/${newer.id}/`}
            rel="next"
            class:list={[
              "cell hover-tint px-[26px] py-5",
              // Only align right when it is the second of a pair.
              older && "min-[620px]:text-right",
            ]}
          >
            <span class="label mb-2 block text-ink-55">Next &rarr;</span>
            <span class="text-[15px] font-semibold">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Layout>

<style>
  /* 1fr + the 230px contents column; collapses below 900px where the
     rail is hidden. */
  .post-grid {
    grid-template-columns: 1fr 230px;
  }

  @media (width < 900px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-title {
    font-size: 62px;
  }

  @media (width < 900px) {
    .post-title {
      font-size: 44px;
    }
  }

  @media (width < 620px) {
    .post-title {
      font-size: 32px;
    }
  }
</style>
