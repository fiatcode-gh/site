---
import TableOfContents from "@/components/TableOfContents.astro";
import TagList from "@/components/TagList.astro";
import Layout from "@/layouts/Layout.astro";
import { isoDate, newestFirst } from "@/lib/posts";
import {
  getCollection,
  render,
  type CollectionEntry,
  type RenderResult,
} from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    newestFirst,
  );

  return Promise.all(
    posts.map(async (post, i) => ({
      params: { id: post.id },
      props: {
        post,
        content: await render(post),
        // Sorted newest-first, so the *newer* neighbour is the previous index.
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
      },
    })),
  );
}

interface Props {
  post: CollectionEntry<"blog">;
  content: RenderResult;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
}

const { post, content, newer, older } = Astro.props;

const date = isoDate(post.data.date);
const tags = post.data.tags ?? [];

// ~200 words per minute, rounded up, floor of 1.
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.round(words / 200));

const file = `${post.id}.md`;
const sourceUrl = `https://github.com/fiatcode-gh/site/blob/main/src/content/blog/${file}`;
---

<Layout
  title={`${post.data.title} | fiatcode`}
  description={post.data.description}
  crumbs={[
    { label: "posts", href: "/posts/" },
    { label: date.slice(0, 4) },
    { label: file },
  ]}
>
  <article class="post">
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>{readTime} min read</span>
        <TagList tags={tags} />
      </div>
    </header>

    <TableOfContents headings={content.headings} variant="mobile" />

    <div class="prose">
      <content.Content />
    </div>

    <p class="comment source">
      // source: <a href={sourceUrl} rel="noopener">src/content/blog/{file}</a>
    </p>

    <nav class="pager" aria-label="Previous and next post">
      {
        older ? (
          <a href={`/posts/${older.id}/`} rel="prev">
            <span class="dir">&larr; previous</span>
            <span class="ttl">{older.data.title}</span>
          </a>
        ) : (
          <div class="edge">
            <span class="dir">&larr; previous</span>
            <span class="ttl">This is the first post.</span>
          </div>
        )
      }
      {
        newer ? (
          <a href={`/posts/${newer.id}/`} rel="next" class="next">
            <span class="dir">next &rarr;</span>
            <span class="ttl">{newer.data.title}</span>
          </a>
        ) : (
          <div class="edge next">
            <span class="dir">next &rarr;</span>
            <span class="ttl">You're on the latest post.</span>
          </div>
        )
      }
    </nav>
  </article>

  <aside class="post-rail" slot="outline" aria-label="Outline">
    <div class="post-rail-inner">
      <p class="post-rail-title">Outline</p>
      <TableOfContents headings={content.headings} />
      <dl class="facts">
        <dt>date</dt>
        <dd>{date}</dd>
        <dt>read</dt>
        <dd>~{readTime} min</dd>
        <dt>tags</dt>
        <dd>{tags.length}</dd>
      </dl>
    </div>
  </aside>
</Layout>

<style>
  .post {
    max-width: 72ch;
  }

  .post-head h1 {
    max-width: 24ch;
    margin: 0 0 20px;
    font-size: clamp(2rem, 4.2vw, 2.875rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    padding-bottom: 28px;
    font: 400 0.8125rem/1.5 var(--font-mono);
    color: var(--color-faint);
  }

  .sep {
    color: var(--color-gutter);
  }

  .source {
    max-width: 68ch;
    margin-top: 40px;
    overflow-wrap: anywhere;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    max-width: 68ch;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--color-line);
  }

  .pager > * {
    display: block;
    padding: 16px 18px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    color: var(--color-fg);
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--color-line-strong);
    background: var(--color-raised);
  }

  .pager .next {
    text-align: right;
  }

  .dir {
    display: block;
    margin-bottom: 6px;
    font: 500 0.75rem/1.2 var(--font-mono);
    color: var(--color-faint);
  }

  .pager a .dir {
    color: var(--color-fn);
  }

  .ttl {
    font-weight: 600;
    line-height: 1.4;
  }

  /* No neighbour that way: a dashed placeholder, so the pair keeps its
     shape and says why there is no link. */
  .pager .edge {
    border-style: dashed;
    color: var(--color-muted);
  }

  .edge .ttl {
    font-weight: 400;
  }

  /* ── Outline rail ────────────────────────────────────────── */

  /* Not `.outline`: that is a Tailwind utility (outline-style/width), and a
     component class with a utility's name picks up its declarations. */
  .post-rail {
    padding: 56px 20px 40px 0;
    border-left: 1px solid var(--color-line);
    font-family: var(--font-mono);
  }

  .post-rail-inner {
    position: sticky;
    top: 24px;
  }

  .post-rail-title {
    margin: 0 0 12px;
    padding-left: 20px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    margin: 28px 0 0 20px;
    padding: 14px 0 0;
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
    color: var(--color-faint);
  }

  .facts dd {
    margin: 0;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pager > * {
      transition:
        background-color 120ms ease,
        border-color 120ms ease;
    }
  }

  @media (width < 900px) {
    .post-rail {
      display: none;
    }
  }

  @media (width < 620px) {
    .source a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }

    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager .next {
      text-align: left;
    }
  }
</style>
