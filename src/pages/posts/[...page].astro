---
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import type { Page, PaginateFunction } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(posts, { pageSize: 10 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<Layout
  title="Posts | fiatcode"
  description="Read the latest blog posts by fiatcode"
>
  <PageHeader title="Posts">
    <div class="label-meta flex items-baseline gap-4" slot="aside">
      <a href="/rss.xml" class="chip hover-accent">rss</a>
      <span>
        {page.total} posts &middot; page {page.currentPage} of {page.lastPage}
      </span>
    </div>
  </PageHeader>

  {page.data.map((post) => <PostRow post={post} />)}

  <!--
    Pager. The counter carries no side rules, so the prev and next cells
    can each own one edge without any pair of borders stacking.
  -->
  <nav class="band flex" aria-label="Pagination">
    {
      page.url.prev && (
        <a
          href={page.url.prev}
          rel="prev"
          class="hover-tint border-r border-ink px-[26px] py-4 text-[12.5px] font-semibold"
        >
          &larr; prev
        </a>
      )
    }
    <span class="flex-1 px-[26px] py-4 text-xs text-ink-55">
      {page.currentPage} / {page.lastPage}
    </span>
    {
      page.url.next && (
        <a
          href={page.url.next}
          rel="next"
          class="hover-tint border-l border-ink px-[26px] py-4 text-[12.5px] font-semibold"
        >
          next &rarr;
        </a>
      )
    }
  </nav>
</Layout>
