---
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import { newestFirst } from "@/lib/posts";
import type { Page, PaginateFunction } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    newestFirst,
  );
  return paginate(posts, { pageSize: 10 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;

// Page 1 is /posts itself; later pages read as a page of it, not a "2" file.
const crumbs =
  page.currentPage === 1
    ? [{ label: "posts" }]
    : [
        { label: "posts", href: "/posts/" },
        { label: `page ${page.currentPage}` },
      ];
---

<Layout
  title="Posts | fiatcode"
  description="Read the latest blog posts by fiatcode"
  crumbs={crumbs}
>
  <PageHeader
    title="Posts"
    comment={`${page.total} posts · page ${page.currentPage} of ${page.lastPage}`}
  >
    <a href="/rss.xml" class="chip" slot="aside">rss</a>
  </PageHeader>

  <ol class="postlist">
    {page.data.map((post) => <PostRow post={post} />)}
  </ol>

  <nav class="pagination" aria-label="Pagination">
    {
      page.url.prev ? (
        <a href={page.url.prev} rel="prev" class="chip">
          &larr; prev
        </a>
      ) : (
        <span />
      )
    }
    <span class="pos">{page.currentPage} / {page.lastPage}</span>
    {
      page.url.next ? (
        <a href={page.url.next} rel="next" class="chip">
          next &rarr;
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Layout>

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  .pagination [rel="next"] {
    justify-self: end;
  }

  .pos {
    font: 400 0.8125rem/1 var(--font-mono);
    color: var(--color-faint);
  }
</style>
