---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Not found | fiatcode"
  description="That page does not exist."
  crumbs={[{ label: "404" }]}
>
  <p class="comment">// ENOENT: no such file or directory</p>
  <h1 class="page-title">This page doesn't exist</h1>
  <p class="page-lead">
    The URL is wrong, the post moved, or I broke a link. Nothing was logged
    &mdash; there's no tracker here to log it.
  </p>
  <div class="actions">
    <a href="/" class="chip chip-primary">go home</a>
    <a href="/search/" class="chip">search the posts</a>
  </div>
</Layout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
