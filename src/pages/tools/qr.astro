---
import QrTool from "@/components/tools/QrTool.svelte";
import ToolShell from "@/components/ToolShell.astro";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "qr")!;
---

<Layout title={`${tool.name} | fiatcode`} description={tool.description}>
  <ToolShell slug={tool.slug} description={tool.description}>
    <QrTool client:visible />
  </ToolShell>
</Layout>
