---
import CronTool from "@/components/tools/CronTool.svelte";
import ToolShell from "@/components/ToolShell.astro";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "cron")!;
---

<Layout title={`${tool.name} | fiatcode`} description={tool.description}>
  <ToolShell slug={tool.slug} description={tool.description}>
    <CronTool client:visible />
  </ToolShell>
</Layout>
