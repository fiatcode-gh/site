---
import ToolShell from "@/components/ToolShell.astro";
import ExifStripperTool from "@/components/tools/ExifStripperTool.svelte";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "exif-stripper")!;
---

<Layout
  title={`${tool.name} | fiatcode`}
  description={tool.description}
  sidebar={false}
>
  <ToolShell name={tool.name} description={tool.description}>
    <!-- client:load (not visible): file drops must work the instant the page shows -->
    <ExifStripperTool client:load />
  </ToolShell>
</Layout>
