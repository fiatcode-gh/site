---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";
---

<Layout
  title="Tools | fiatcode"
  description="Small, fully client-side developer utilities. Everything runs in your browser — nothing is uploaded."
>
  <PageHeader
    title="Tools"
    comment={`${tools.length} tools`}
    lead='Small utilities that run entirely in your browser. <span class="hl">No uploads, no trackers, no servers.</span>'
  >
    <span class="local-note" slot="aside">Runs in your browser</span>
  </PageHeader>

  <ul class="fn-list tool-index">
    {
      tools.map((tool) => (
        <li>
          <a href={`/tools/${tool.slug}/`}>
            <span class="fn-name">{tool.slug}</span>
            <span class="fn-desc">{tool.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  /* Full descriptions need the width: one column, a wider name column. */
  .tool-index {
    grid-template-columns: minmax(0, 1fr);
  }

  .tool-index a {
    grid-template-columns: 12rem minmax(0, 1fr);
    padding-block: 18px;
  }

  @media (width < 620px) {
    .tool-index a {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
