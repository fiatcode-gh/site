---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";
---

<Layout
  title="Tools | fiatcode"
  description="Small, fully client-side developer utilities. Everything runs in your browser — nothing is uploaded."
>
  <PageHeader
    title="Tools"
    lead='Small utilities that run entirely in your browser. <span class="hl">No uploads, no trackers, no servers.</span>'
  />

  <div class="ruled band grid-cols-2 max-[619px]:grid-cols-1">
    {
      tools.map((tool) => (
        <a
          href={`/tools/${tool.slug}/`}
          class="cell hover-tint block px-[26px] py-[22px]"
        >
          <span class="mb-2 flex items-baseline justify-between gap-3">
            <span class="text-xl font-bold tracking-[-0.01em]">
              {tool.slug}
            </span>
            <span class="text-[11px] text-ink-55">/tools/{tool.slug}</span>
          </span>
          <span class="block text-[13px] leading-[1.6] text-ink-62">
            {tool.description}
          </span>
        </a>
      ))
    }
  </div>
</Layout>
