---
import ToolShell from "@/components/ToolShell.astro";
import WorkoutTool from "@/components/tools/WorkoutTool.svelte";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "workout")!;
---

<Layout title={`${tool.name} | fiatcode`} description={tool.description}>
  <!-- bleed: the island draws its own banner band and pads each screen
       itself, the way ToolShell would. -->
  <ToolShell slug={tool.slug} description={tool.description} bleed>
    <!-- client:load: the saved plan is read from this browser on mount -->
    <WorkoutTool client:load />
    <noscript
      ><p class="tool-error">
        Workout needs JavaScript to plan and track your sessions.
      </p></noscript
    >
  </ToolShell>
</Layout>
