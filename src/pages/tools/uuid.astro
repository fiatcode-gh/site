---
import ToolShell from "@/components/ToolShell.astro";
import UuidTool from "@/components/tools/UuidTool.svelte";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "uuid")!;
---

<Layout title={`${tool.name} | fiatcode`} description={tool.description}>
  <ToolShell slug={tool.slug} description={tool.description}>
    <UuidTool client:visible />
  </ToolShell>
</Layout>
