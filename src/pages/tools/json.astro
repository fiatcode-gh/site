---
import ToolShell from "@/components/ToolShell.astro";
import JsonTool from "@/components/tools/JsonTool.svelte";
import Layout from "@/layouts/Layout.astro";
import { tools } from "@/lib/tools/registry";

const tool = tools.find((t) => t.slug === "json")!;
---

<Layout
  title={`${tool.name} | fiatcode`}
  description={tool.description}
  sidebar={false}
>
  <ToolShell name={tool.name} description={tool.description}>
    <JsonTool client:visible />
  </ToolShell>
</Layout>
