---
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import { newestFirst } from "@/lib/posts";
import type { SearchDoc } from "@/lib/search";
import { getCollection } from "astro:content";

/**
 * Search over title, description and tags.
 *
 * Every row is rendered at build time and the script only toggles which
 * ones are visible. That keeps one copy of the row markup (PostRow),
 * needs no escaping, and leaves the page useful with JavaScript off —
 * it degrades to the full post list.
 *
 * The match index is inlined rather than fetched: at this post count it
 * is a few kilobytes, so inlining costs less than the round trip and
 * there is no loading state to design. Move it to a generated JSON
 * endpoint if the archive ever grows into the hundreds.
 */
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  newestFirst,
);

const index: SearchDoc[] = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags ?? [],
}));

const tryChips = ["podman", "flutter", "linux", "ai"];
---

<Layout
  title="Search | fiatcode"
  description="Search posts on fiatcode.dev — runs entirely in your browser"
>
  <PageHeader title="Search" comment="runs in your browser · nothing is sent">
    <!-- The bordered box is the control; the prompt and count sit inside it. -->
    <div class="search-box">
      <span class="prompt" aria-hidden="true">/</span>
      <label class="sr-only" for="q">Search posts</label>
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="podman, flutter, tdd…"
        data-search-input
      />
      <span class="found" aria-live="polite" data-count>
        {posts.length} found
      </span>
    </div>

    <div class="try">
      <span class="try-label">try</span>
      {
        tryChips.map((t) => (
          <button type="button" class="chip" data-try={t}>
            {t}
          </button>
        ))
      }
    </div>
  </PageHeader>

  <ol class="postlist">
    {posts.map((post) => <PostRow post={post} data-post-row={post.id} />)}
  </ol>

  <p class="empty hidden" data-empty>
    No posts match. Everything is indexed locally &mdash; no query leaves your
    browser.
  </p>

  <script
    is:inline
    type="application/json"
    data-search-index
    set:html={JSON.stringify(index)}
  />
</Layout>

<style>
  .search-box {
    display: flex;
    align-items: stretch;
    margin-top: 24px;
    border: 1px solid var(--color-field);
    border-radius: 8px;
    background: var(--color-raised);
    font-family: var(--font-mono);
  }

  /* The box shows focus for the input inside it. */
  .search-box:focus-within {
    outline: 2px solid var(--color-fn);
    outline-offset: 2px;
  }

  .search-box input:focus-visible {
    outline: 0;
  }

  .prompt {
    display: flex;
    align-items: center;
    padding: 0 10px 0 16px;
    font-size: 0.9375rem;
    color: var(--color-kw);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    border: 0;
    background: transparent;
    font-size: 0.9375rem;
    color: var(--color-fg);
  }

  .found {
    display: flex;
    flex: none;
    align-items: center;
    padding: 0 16px;
    border-left: 1px solid var(--color-line);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }

  .try-label {
    font: 400 0.75rem/1 var(--font-mono);
    color: var(--color-faint);
  }

  .empty {
    margin: 0;
    padding: 40px 0;
    color: var(--color-muted);
  }
</style>

<script>
  import { matchPosts, type SearchDoc } from "@/lib/search";

  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const indexEl = document.querySelector<HTMLScriptElement>(
    "[data-search-index]",
  );

  if (input && count && empty && indexEl) {
    const index: SearchDoc[] = JSON.parse(indexEl.textContent ?? "[]");
    const rows = new Map<string, HTMLElement>();
    for (const el of document.querySelectorAll<HTMLElement>(
      "[data-post-row]",
    )) {
      rows.set(el.dataset.postRow!, el);
    }

    const render = (query: string) => {
      const visible = new Set(matchPosts(index, query).map((d) => d.id));
      for (const [id, el] of rows) el.hidden = !visible.has(id);
      count.textContent = `${visible.size} found`;
      empty.classList.toggle("hidden", visible.size > 0);
    };

    input.addEventListener("input", () => render(input.value));

    for (const chip of document.querySelectorAll<HTMLButtonElement>(
      "[data-try]",
    )) {
      chip.addEventListener("click", () => {
        input.value = chip.dataset.try ?? "";
        render(input.value);
        input.focus();
      });
    }

    // Support deep links like /search?q=podman.
    const initial = new URLSearchParams(location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      render(initial);
    }
  }
</script>
