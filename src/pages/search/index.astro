---
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import type { SearchDoc } from "@/lib/search";
import { getCollection } from "astro:content";

/**
 * Search over title, description and tags.
 *
 * Every row is rendered at build time and the script only toggles which
 * ones are visible. That keeps one copy of the row markup (PostRow),
 * needs no escaping, and leaves the page useful with JavaScript off —
 * it degrades to the full post list.
 *
 * The match index is inlined rather than fetched: at this post count it
 * is a few kilobytes, so inlining costs less than the round trip and
 * there is no loading state to design. Move it to a generated JSON
 * endpoint if the archive ever grows into the hundreds.
 */
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const index: SearchDoc[] = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags ?? [],
}));

const tryChips = ["podman", "flutter", "linux", "ai"];
---

<Layout
  title="Search | fiatcode"
  description="Search posts on fiatcode.dev — runs entirely in your browser"
>
  <div class="band px-[26px] pb-[26px] pt-11">
    <h1 class="search-title display mb-[22px] leading-none">Search</h1>

    <!-- The bordered box is the control; the slash and count sit inside it. -->
    <div class="flex border border-ink">
      <span class="py-3.5 pl-4 pr-3.5 text-sm text-ink-55" aria-hidden="true">
        /
      </span>
      <label class="sr-only" for="q">Search posts</label>
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="podman, flutter, tdd…"
        class="min-w-0 flex-1 border-0 bg-transparent py-3.5 text-[15px] outline-0"
        data-search-input
      />
      <span
        class="label-meta flex flex-none items-center gap-1.5 border-l border-ink bg-accent px-4 py-3.5 tracking-[0.1em]"
        aria-live="polite"
        data-count
      >
        {posts.length} found
      </span>
    </div>

    <div class="mt-3.5 flex flex-wrap gap-2">
      <span class="label-meta py-1.5 tracking-[0.1em] text-ink-55">Try</span>
      {
        tryChips.map((t) => (
          <button type="button" class="chip hover-tint" data-try={t}>
            {t}
          </button>
        ))
      }
    </div>
  </div>

  {
    posts.map((post) => (
      <div data-post-row={post.id}>
        <PostRow post={post} compact />
      </div>
    ))
  }

  <p class="band hidden px-[26px] py-10 text-sm text-ink-62" data-empty>
    No posts match. Everything is indexed locally &mdash; no query leaves your
    browser.
  </p>

  <script
    is:inline
    type="application/json"
    data-search-index
    set:html={JSON.stringify(index)}
  />
</Layout>

<style>
  .search-title {
    font-size: 64px;
  }

  @media (width < 900px) {
    .search-title {
      font-size: 48px;
    }
  }

  @media (width < 620px) {
    .search-title {
      font-size: 38px;
    }
  }
</style>

<script>
  import { matchPosts, type SearchDoc } from "@/lib/search";

  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const indexEl = document.querySelector<HTMLScriptElement>(
    "[data-search-index]",
  );

  if (input && count && empty && indexEl) {
    const index: SearchDoc[] = JSON.parse(indexEl.textContent ?? "[]");
    const rows = new Map<string, HTMLElement>();
    for (const el of document.querySelectorAll<HTMLElement>(
      "[data-post-row]",
    )) {
      rows.set(el.dataset.postRow!, el);
    }

    const render = (query: string) => {
      const visible = new Set(matchPosts(index, query).map((d) => d.id));
      for (const [id, el] of rows) el.hidden = !visible.has(id);
      count.textContent = `${visible.size} found`;
      empty.classList.toggle("hidden", visible.size > 0);
    };

    input.addEventListener("input", () => render(input.value));

    for (const chip of document.querySelectorAll<HTMLButtonElement>(
      "[data-try]",
    )) {
      chip.addEventListener("click", () => {
        input.value = chip.dataset.try ?? "";
        render(input.value);
        input.focus();
      });
    }

    // Support deep links like /search?q=podman.
    const initial = new URLSearchParams(location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      render(initial);
    }
  }
</script>
