---
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import { newestFirst } from "@/lib/posts";
import { tools } from "@/lib/tools/registry";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  newestFirst,
);

const latest = posts.slice(0, 3);

// The about.yaml pane: keys are YAML keys, values are prose.
const about = [
  {
    key: "currently",
    body: 'Local startup where <strong>"full-stack"</strong> means Flutter, Spring, and React Router — sometimes all in the same day.',
  },
  {
    key: "the_craftsmans_way",
    body: "Quality is not negotiable. Clean Architecture, TDD, and DDD aren't just buzzwords here; they're how I try to keep my sanity intact.",
  },
  {
    key: "this_site",
    body: "Built with Astro, because life's too short for slow websites. No trackers.",
  },
];
---

<Layout
  title="fiatcode"
  description="Cross-platform developer, Linux native, craftsman at heart. Writing about building apps, self-hosting, and software craftsmanship."
  crumbs={[{ label: "README.md" }]}
>
  <section class="hero" aria-labelledby="hi">
    <p class="comment">
      // Cross-platform developer &middot; Linux native &middot; Craftsman at
      heart
    </p>
    <h1 id="hi">Hi, I'm <span class="name">fiatcode</span></h1>
    <div class="intro">
      <p>
        I write about building apps, learning new tech, and the occasional
        existential crisis that comes with debugging production code. This is
        where I share what I'm working on, what I'm learning, and thoughts that
        don't fit in a commit message.
      </p>
      <p>
        Stick around if you're into cross-platform dev, software craftsmanship,
        or just want to see someone figure things out in public.
      </p>
    </div>

    <div class="split about-pane">
      <div class="split-head">
        <span class="split-tab">
          <span class="ico ico-md" aria-hidden="true">&lbrace;&rbrace;</span>
          about.yaml
        </span>
        <span aria-hidden="true">YAML</span>
      </div>
      <dl class="about">
        {
          about.map((row) => (
            <div class="about-row">
              <dt>{row.key}</dt>
              <dd set:html={row.body} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">
        Latest posts <span class="path" aria-hidden="true">posts/</span>
      </h2>
      <a class="more-link" href="/posts/">All {posts.length} posts &rarr;</a>
    </div>
    <ol class="postlist">
      {latest.map((post) => <PostRow post={post} level={3} />)}
    </ol>
  </section>

  <section class="section" aria-labelledby="tools-h">
    <div class="section-head">
      <h2 id="tools-h">
        Tools <span class="path" aria-hidden="true">tools/</span>
      </h2>
      <span class="local-note"
        >Runs in your browser &middot; nothing uploaded</span
      >
    </div>
    <ul class="fn-list">
      {
        tools.map((t) => (
          <li>
            <a href={`/tools/${t.slug}/`}>
              <span class="fn-name">{t.slug}</span>
              <span class="fn-desc">{t.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .hero h1 {
    margin: 0 0 24px;
    font-size: clamp(2.375rem, 5.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .name {
    color: var(--color-fn);
  }

  .intro p {
    max-width: 62ch;
    margin: 0 0 1em;
    font-size: 1.1875rem;
    line-height: 1.65;
  }

  .intro p + p {
    font-size: 1.0625rem;
    color: var(--color-muted);
  }

  .about-pane {
    margin-top: 40px;
  }

  /* Each row is a numbered YAML line: gutter number, key, value. */
  .about {
    margin: 0;
    padding: 14px 0;
    counter-reset: ln;
  }

  .about-row {
    display: grid;
    grid-template-columns: 52px 13rem minmax(0, 1fr);
    padding: 8px 24px 8px 0;
    counter-increment: ln;
  }

  .about-row::before {
    content: counter(ln);
    content: counter(ln) / "";
    padding-right: 20px;
    font: 400 0.75rem/1.9 var(--font-mono);
    color: var(--color-gutter);
    text-align: right;
  }

  .about dt {
    font: 500 0.875rem/1.9 var(--font-mono);
    color: var(--color-kw);
  }

  .about dt::after {
    content: ":";
    content: ":" / "";
    color: var(--color-faint);
  }

  .about dd {
    margin: 0;
    padding-top: 2px;
    line-height: 1.6;
  }

  .about dd :global(strong) {
    font-weight: 600;
    color: var(--color-str);
  }

  @media (width < 620px) {
    .intro p {
      font-size: 1.125rem;
    }

    .about-row {
      grid-template-columns: 34px minmax(0, 1fr);
      padding-right: 18px;
    }

    .about-row::before {
      grid-row: span 2;
      padding-right: 12px;
    }

    .about dd {
      grid-column: 2;
    }
  }
</style>
