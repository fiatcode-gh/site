---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { tagCounts } from "@/lib/posts";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Most used first — the order carries the frequency signal, so every tag
// is set identically: no size or weight escalation by count.
const tags = tagCounts(posts);
---

<Layout title="Tags | fiatcode" description="Browse blog posts by tag">
  <PageHeader
    title="Tags"
    comment={`${tags.length} tags · ${posts.length} posts`}
    lead="Ordered by how much I write about them."
  />

  <ul class="tag-index">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`}>
            <span class="tag-name">{tag}</span>
            <span class="tag-count">
              {count}
              <span class="sr-only">{count === 1 ? "post" : "posts"}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .tag-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 32px;
  }

  .tag-index li {
    border-bottom: 1px solid var(--color-line);
  }

  .tag-index a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    margin: 0 -12px;
    padding: 12px;
    border-radius: 6px;
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .tag-index a:hover {
    background: var(--color-raised);
  }

  .tag-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-str);
    overflow-wrap: anywhere;
  }

  .tag-name::before {
    content: "#";
    content: "#" / "";
    opacity: 0.7;
  }

  .tag-count {
    font-size: 0.75rem;
    color: var(--color-faint);
  }

  @media (width < 900px) {
    .tag-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 620px) {
    .tag-index {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
