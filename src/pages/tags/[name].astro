---
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));

  return [...tags].map((name) => ({
    params: { name },
    props: { tagged: posts.filter((post) => post.data.tags?.includes(name)) },
  }));
}

interface Props {
  tagged: CollectionEntry<"blog">[];
}

const { name } = Astro.params;
const { tagged } = Astro.props;
---

<Layout
  title={`#${name} | fiatcode`}
  description={`Blog posts tagged ${name} by fiatcode`}
>
  <PageHeader title={`#${name}`}>
    <span class="label-meta" slot="aside">
      {tagged.length}
      {tagged.length === 1 ? "post" : "posts"}
    </span>
  </PageHeader>

  {tagged.map((post) => <PostRow post={post} />)}

  <div class="band flex">
    <a
      href="/tags"
      class="hover-tint px-[26px] py-4 text-[12.5px] font-semibold"
    >
      &larr; all tags
    </a>
  </div>
</Layout>
