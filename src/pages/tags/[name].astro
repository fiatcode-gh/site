---
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Layout from "@/layouts/Layout.astro";
import { newestFirst } from "@/lib/posts";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    newestFirst,
  );

  const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));

  return [...tags].map((name) => ({
    params: { name },
    props: { tagged: posts.filter((post) => post.data.tags?.includes(name)) },
  }));
}

interface Props {
  tagged: CollectionEntry<"blog">[];
}

const { name } = Astro.params;
const { tagged } = Astro.props;
---

<Layout
  title={`#${name} | fiatcode`}
  description={`Blog posts tagged ${name} by fiatcode`}
>
  <PageHeader
    title={`#${name}`}
    comment={`${tagged.length} ${tagged.length === 1 ? "post" : "posts"} tagged ${name}`}
  >
    <a href="/tags/" class="chip" slot="aside">&larr; all tags</a>
  </PageHeader>

  <ol class="postlist">
    {tagged.map((post) => <PostRow post={post} />)}
  </ol>
</Layout>
